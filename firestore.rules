rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }
    function validProfile() {
      return request.resource.data.keys().hasOnly([
          'displayName', 'username', 'avatar', 'phone',
          'phoneDiscoverable', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'username', 'avatar', 'phone',
          'phoneDiscoverable', 'createdAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.username is string
        && request.resource.data.username.matches('[a-z0-9_]{3,20}')
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 150000
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 16
        && request.resource.data.phoneDiscoverable is bool;
    }
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && validProfile()
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }
    match /phoneDirectory/{number} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == number
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneDiscoverable == true;
      allow update, delete: if false;
    }
    match /notificationTokens/{userId} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 4096
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /chats/{chatId} {
      allow get: if isMember(chatId);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberIds', 'createdAt'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds[0] is string
        && request.resource.data.memberIds[1] is string
        && request.resource.data.memberIds[0] < request.resource.data.memberIds[1]
        && request.auth.uid in request.resource.data.memberIds
        && chatId == request.resource.data.memberIds[0] + '_' + request.resource.data.memberIds[1]
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /messages/{messageId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId)
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
