rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function validMembers(ids) {
      return ids is list
        && ids.size() == 2
        && ids[0] is string && ids[1] is string
        && ids[0] != ids[1];
    }
    function member(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'username', 'avatar', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName', 'username', 'avatar', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 150000
        && (resource == null || request.resource.data.username == resource.data.username)
        && (resource != null || request.resource.data.createdAt == request.time);
      allow delete: if false;
    }
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }
    match /chats/{chatId} {
      allow get, list: if member(chatId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberIds', 'createdAt'])
        && validMembers(request.resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && chatId == request.resource.data.memberIds[0] + '_' + request.resource.data.memberIds[1]
        && request.resource.data.memberIds[0] < request.resource.data.memberIds[1]
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /messages/{messageId} {
        allow read: if member(chatId);
        allow create: if member(chatId)
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
